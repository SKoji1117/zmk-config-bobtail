#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos { compatible = "zmk,combos"; };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        bt_0_win: bt_0_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 1>, <&macro_wait_time 200>, <&bt BT_SEL 0>;

            label = "BT_0_WIN";
            wait-ms = <200>;
        };

        bt_1_mac: bt_1_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0>, <&macro_wait_time 200>, <&bt BT_SEL 1>;

            label = "BT_1_MAC";
        };

        bt_2_mac: bt_2_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2>, <&macro_wait_time 200>, <&to 0>;

            label = "BT_2_MAC";
        };

        bt_3_android: bt_3_android {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 1>, <&macro_wait_time 200>, <&bt BT_SEL 3>;

            label = "BT_3_ANDROID";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Mac-Default_Layer {
            bindings = <
&kp Q      &kp W         &kp E         &kp R                      &kp T                                                &kp Y           &kp U       &kp I             &kp O       &kp P
&kp A      &kp S         &kp D         &kp F                      &kp G           &kp ESC             &kp AT_SIGN      &kp H           &kp J       &kp K             &kp L       &kp MINUS
&kp Z      &kp X         &kp C         &kp V                      &kp B           &kp LG(LS(N4))      &lt 7 HASH       &kp N           &kp M       &kp COMMA         &kp PERIOD  &kp SLASH
&kp LCTRL  &kp LEFT_ALT  &kp LEFT_GUI  &mt LEFT_SHIFT LANGUAGE_1  &lt 2 SPACE     &lt 6 LANGUAGE_2    &lt 4 ENTER      &kp BACKSPACE                                             &kp DELETE
            >;

            // デスクトップ（Mission Control の操作スペース）の切り替え。他のレイヤーにも透過する
            sensor-bindings = <&inc_dec_kp LC(RIGHT_ARROW) LC(LEFT_ARROW)>;
        };

        Win-Default_Layer {
            bindings = <
&kp Q      &kp W         &kp E             &kp R                      &kp T                                                &kp Y           &kp U        &kp I             &kp O       &kp P
&kp A      &kp S         &kp D             &kp F                      &kp G           &kp ESC             &kp AT_SIGN      &kp H           &kp J        &kp K             &kp L       &kp MINUS
&kp Z      &kp X         &kp C             &kp V                      &kp B           &kp LG(LS(S))       &lt 7 HASH       &kp N           &kp M        &kp COMMA         &kp PERIOD  &kp SLASH
&kp LCTRL  &kp LEFT_ALT  &kp LEFT_GUI      &mt LEFT_SHIFT LANGUAGE_1  &lt 3 SPACE     &lt 6 LANGUAGE_2    &lt 5 ENTER      &kp BACKSPACE                                              &kp DELETE
            >;
        };

        Mac-Function_Layer {
            bindings = <
&kp LG(A)  &kp LG(X)     &kp LG(C)    &kp LG(V)  &kp LG(F)                                      &kp LESS_THAN         &kp GREATER_THAN       &kp CARET        &kp PERCENT    &kp DOLLAR
&kp TAB    &kp LEFT_GUI  &kp LS(TAB)  &mkp MB1   &mkp MB2   &trans              &kp GRAVE       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp AT_SIGN      &kp AMPERSAND  &kp DOUBLE_QUOTES
&trans     &trans        &trans       &trans     &mkp MB3   &kp LG(LS(N5))      &kp BACKSLASH   &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp EXCLAMATION  &kp QUESTION   &kp SQT
&trans     &trans        &trans       &trans     &trans     &trans              &kp ENTER       &kp BACKSPACE                                                                &kp HASH
            >;
        };

        Win-Function_Layer {
            bindings = <
&kp LC(A)  &kp LC(X)  &kp LC(C)    &kp LC(V)  &kp LC(LS(V))                              &kp LESS_THAN         &kp GREATER_THAN       &kp CARET        &kp PERCENT    &kp DOLLAR
&kp TAB    &kp LCTRL  &kp LS(TAB)  &mkp MB1   &mkp MB2       &trans      &kp COLON       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp AT_SIGN      &kp AMPERSAND  &kp DOUBLE_QUOTES
&trans     &trans     &trans       &trans     &mkp MB3       &trans      &kp BACKSLASH   &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp EXCLAMATION  &kp QUESTION   &kp SQT
&trans     &trans     &trans       &trans     &trans         &trans      &kp ENTER       &kp BACKSPACE                                                                &kp HASH
            >;
        };

        Mac-Common_Layer {
            bindings = <
&kp ESCAPE      &trans    &trans       &kp LG(UP_ARROW)    &trans                                          &kp LG(W)        &mkp MB1            &mkp MB3      &mkp MB2             &kp HOME
&kp TAB         &kp LCMD  &kp LS(TAB)  &kp LG(LEFT_ARROW)  &kp LG(RIGHT_ARROW)  &trans      &kp LG(T)      &kp LEFT_ARROW   &kp DOWN_ARROW      &kp UP_ARROW  &kp RIGHT_ARROW      &kp PAGE_UP
&kp LEFT_SHIFT  &trans    &trans       &kp LG(DOWN_ARROW)  &trans               &trans      &trans         &kp LG(LS(TAB))  &kp LG(LEFT_ARROW)  &kp SEMI      &kp LG(RIGHT_ARROW)  &kp PAGE_DOWN
&kp LCTRL       &trans    &trans       &trans              &trans               &trans      &trans         &trans                                                                  &kp END
            >;
        };

        Win-Common_Layer {
            bindings = <
&kp ESCAPE      &trans     &trans       &kp LC(UP_ARROW)    &trans                                          &kp LC(W)          &mkp MB1            &mkp MB3       &mkp MB2             &kp HOME
&kp TAB         &kp LCTRL  &kp LS(TAB)  &kp LC(LEFT_ARROW)  &kp LC(RIGHT_ARROW)  &trans      &kp LC(T)      &kp LEFT_ARROW     &kp DOWN_ARROW      &kp UP_ARROW   &kp RIGHT_ARROW      &kp PAGE_UP
&kp LEFT_SHIFT  &trans     &trans       &kp LC(DOWN_ARROW)  &trans               &trans      &trans         &kp LC(PAGE_DOWN)  &kp LA(LEFT_ARROW)  &kp SEMICOLON  &kp LA(RIGHT_ARROW)  &kp PAGE_DOWN
&kp LCTRL       &trans     &trans       &trans              &trans               &trans      &trans         &trans                                                                     &kp END
            >;
        };

        Num_Layer {
            bindings = <
&kp F1   &kp F2   &kp F3  &kp F4  &kp F5                                   &kp PLUS      &kp MINUS  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9
&kp F6   &kp F7   &kp F8  &kp F9  &kp F10  &trans      &kp DOLLAR      &kp EQUAL     &kp COLON  &kp N4        &kp N5        &kp N6
&kp F11  &kp F12  &trans  &trans  &trans   &trans      &kp AMPERSAND   &kp ASTERISK  &kp SLASH  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3
&trans   &trans   &trans  &trans  &trans   &trans      &kp ENTER       &kp BACKSPACE                                        &kp N0
            >;
        };

        Setting_Layer {
            bindings = <
&studio_unlock  &trans  &trans  &trans  &trans                                  &bt_0_win   &bt_1_mac  &bt_2_mac  &bt_3_android  &bt BT_SEL 4
&trans          &trans  &trans  &trans  &trans  &trans      &studio_unlock  &trans      &trans     &trans     &trans         &trans
&trans          &trans  &trans  &trans  &trans  &to 0       &trans          &trans      &trans     &trans     &trans         &bt BT_CLR
&trans          &trans  &trans  &trans  &trans  &to 1       &bootloader     &sys_reset                                       &trans
            >;
        };

        AutoMouse_Layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;
        };
    };
};
